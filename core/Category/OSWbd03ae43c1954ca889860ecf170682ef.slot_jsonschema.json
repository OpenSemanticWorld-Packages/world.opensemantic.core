                "title*": {
                    "de": "Operation"
                },
                "type": "object",
                "oneOf": [
                    {
                        "title": "Set (replace the whole slot)",
                        "title*": {
                            "de": "Setzen (ganzen Slot ersetzen)"
                        },
                        "description": "Discards the slot's content and uses this instead.",
                        "description*": {
                            "de": "Verwirft den Inhalt des Slots und verwendet stattdessen diesen."
                        },
