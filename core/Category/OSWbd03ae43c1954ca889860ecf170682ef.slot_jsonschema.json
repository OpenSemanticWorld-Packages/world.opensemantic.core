    "type": "object",
    "uuid": "bd03ae43-c195-4ca8-8986-0ecf170682ef",
    "title": "PagePatch",
    "title*": {
        "en": "Page Patch",
        "de": "Seiten-Patch"
    },
    "description": "Modifies the slots of the pages listed under Targets, at read time, without editing them. A patched category stays patched wherever it is read, including as part of a subcategory's inheritance chain.",
    "description*": {
        "en": "Modifies the slots of the pages listed under Targets, at read time, without editing them. A patched category stays patched wherever it is read, including as part of a subcategory's inheritance chain.",
        "de": "Verändert die Slots der unter Ziele genannten Seiten beim Lesen, ohne sie zu bearbeiten. Eine gepatchte Kategorie bleibt überall gepatcht, auch innerhalb der Vererbungskette einer Unterkategorie."
    },
    "required": [
        "type",
        "patchset",
        "target"
    ],
    "defaultProperties": [
        "patchset",
        "target",
        "header_template",
        "footer_template",
        "jsonschema",
        "jsondata"
    ],
    "properties": {
        "type": {
            "default": [
                "Category:OSWbd03ae43c1954ca889860ecf170682ef"
            ]
        },
        "patchset": {
            "title": "Patch sets",
            "title*": {
                "de": "Patch-Sets"
            },
            "description": "Contexts this patch belongs to. It applies only when the reader asks for one of them: the form editor asks for ui, page rendering for render. Any other name is allowed and stays inert until something asks for it.",
            "description*": {
                "de": "Kontexte, zu denen dieser Patch gehört. Er wird nur angewendet, wenn der Leser einen davon anfordert: der Formular-Editor fordert ui an, das Seitenrendering render. Eigene Namen sind erlaubt und bleiben wirkungslos, bis etwas sie anfordert."
            },
            "propertyOrder": 100,
            "type": "array",
            "format": "table",
            "uniqueItems": true,
            "minItems": 1,
            "default": [
                "render"
            ],
            "items": {
                "title": "Patch set",
                "title*": {
                    "de": "Patch-Set"
                },
                "description": "Lower case letters, digits and hyphens, up to 32 characters. For example render, ui, trial-q3.",
                "description*": {
                    "de": "Kleinbuchstaben, Ziffern und Bindestriche, bis zu 32 Zeichen. Zum Beispiel render, ui, trial-q3."
                },
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                "options": {
                    "input_width": "200px"
                }
            }
        },
        "priority": {
            "title": "Priority",
            "title*": {
                "de": "Priorität"
            },
            "description": "Order when several patches target the same page: lower runs first. Ties break on page title, so the result is deterministic.",
            "description*": {
                "de": "Reihenfolge, wenn mehrere Patches dieselbe Seite betreffen: der niedrigere läuft zuerst. Bei Gleichstand entscheidet der Seitentitel, das Ergebnis ist also eindeutig."
            },
            "propertyOrder": 110,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 100
        },
        "target": {
            "title": "Targets",
            "title*": {
                "de": "Ziele"
            },
            "description": "The pages whose slots this patch modifies. Patch a category to affect everything that inherits from it, or a single item to affect only that item.",
            "description*": {
                "de": "Die Seiten, deren Slots dieser Patch verändert. Eine Kategorie zu patchen wirkt auf alles, was von ihr erbt, ein einzelnes Item nur auf dieses."
            },
            "propertyOrder": 120,
            "type": "array",
            "format": "table",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "title": "Page",
                "title*": {
                    "de": "Seite"
                },
                "type": "string",
                "format": "autocomplete",
                "options": {
                    "autocomplete": {
                        "query": "[[Category:Entity]]OR[[:Category:%2B]]"
                    }
                }
            }
        },
        "header_template": {
            "$ref": "#/$defs/wikitextOps",
            "title": "Header template operations",
            "title*": {
                "de": "Header-Template-Operationen"
            },
            "propertyOrder": 200
        },
        "footer_template": {
