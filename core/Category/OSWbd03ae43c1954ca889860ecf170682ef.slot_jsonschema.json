                                "options": {
                                    "input_width": "800px",
                                    "literal": true,
                                    "input_height": "200px"
                                }
                            }
                        }
                    },
                    {
                        "title": "Replace text",
                        "title*": {
                            "de": "Text ersetzen"
                        },
                        "description": "Exact string match, every occurrence. Prefer this over a regular expression.",
                        "description*": {
                            "de": "Exakte Zeichenkette, jedes Vorkommen. Diesem Modus vor einem regulären Ausdruck den Vorzug geben."
                        },
